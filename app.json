{
  "expo": {
    "name": "ThermoTrack",
    "slug": "thermotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/thermotrack-icon.png",
    "scheme": "thermotrack",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#10151b",
    "ios": {
      "icon": "./assets/images/thermotrack-icon.png",
      "bundleIdentifier": "com.thermotrack.energy",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "ThermoTrack reads live measurements from the ESP32 on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.thermotrack.energy",
      "adaptiveIcon": {
        "backgroundColor": "#10151b",
        "foregroundImage": "./assets/images/thermotrack-adaptive-foreground.png",
        "monochromeImage": "./assets/images/thermotrack-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/thermotrack-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10151b",
          "image": "./assets/images/thermotrack-splash.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
